# Local development. Never commit real credentials.
DATABASE_URL=postgres://ignai:ignai@127.0.0.1:54329/ignai_payload
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
PREVIEW_SECRET=replace-with-a-different-random-secret
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Local development may use Payload's schema push. Keep false in production.
PAYLOAD_DB_PUSH=true

# Optional Cloudflare R2. Without these values, files use local storage.
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=
# Defaults preserve Cloudflare R2 behavior. Aliyun OSS needs cn-hangzhou and false.
R2_REGION=auto
R2_FORCE_PATH_STYLE=true
