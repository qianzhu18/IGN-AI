{
  "name": "@ignai/site",
  "version": "0.1.0",
  "private": true,
  "description": "IGNAI community site — Next.js and Payload CMS migration slice",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": "^20.9.0 || ^22.0.0",
    "pnpm": "^10.0.0"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:safe": "rm -rf .next && pnpm dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "migrate:notion": "tsx scripts/migrate-notion.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "db:migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "db:migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "db:migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "health": "curl --fail --silent --show-error http://localhost:3000/api/health",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/live-preview-react": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/plugin-mcp": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/storage-s3": "3.86.0",
    "@payloadcms/translations": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "cross-env": "7.0.3",
    "dotenv": "16.4.7",
    "framer-motion": "12.38.0",
    "graphql": "16.11.0",
    "next": "16.2.6",
    "payload": "3.86.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "0.34.2"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.6",
    "prettier": "3.6.2",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vitest": "4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
